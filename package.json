{
	"name": "multitent",
	"description": "A multi-tenant Worker publisher: store tenant scripts in KV and run them as Dynamic Workers.",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"e2e:dev": "wrangler dev --config wrangler.e2e.jsonc",
		"start": "wrangler dev",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260811.1",
		"typescript": "5.9.3",
		"wrangler": "4.123.0"
	}
}
