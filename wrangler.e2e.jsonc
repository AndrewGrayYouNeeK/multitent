{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "multitent-e2e",
	"main": "./src/index.ts",
	"compatibility_date": "2025-10-08",
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SCRIPT_STORE",
				"class_name": "ScriptStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ScriptStore"]
		}
	],
	"vars": {
		"READONLY": "false"
	}
}
