{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "multitent-e2e",
	"main": "./src/index.ts",
	"compatibility_date": "2025-10-08",
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SCRIPTS",
			"id": "local-scripts",
			"preview_id": "local-scripts-preview"
		}
	],
	"vars": {
		"READONLY": "false"
	}
}
